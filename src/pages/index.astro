---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { ToolGrid } from '../components/ToolGrid';
import ManifestoSection from '../components/ManifestoSection.astro';
import { getToolBanner } from '../lib/tool-banner';

const toolEntries = await getCollection('tools');
const tools = await Promise.all(
  toolEntries
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({
      id: entry.id,
      ...entry.data,
      banner: await getToolBanner(entry.data.banner),
    }))
);

const siteUrl = Astro.site?.origin ?? 'https://fluidise.dev';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Fluidise',
      description: 'The Agent-First Developer Experience Suite',
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Fluidise',
      url: siteUrl,
      logo: `${siteUrl}/brand/logo.svg`,
      sameAs: ['https://github.com/Fluidise'],
    },
  ],
};
---

<Layout jsonLd={jsonLd}>
  <Hero />
  <ToolGrid client:visible tools={tools} />
  <noscript>
    <style is:inline>
      .task-preview-toggle { display: none; }
      .task-preview-content[data-expanded] { display: block; margin-top: 0; }
    </style>
  </noscript>
  <ManifestoSection />
</Layout>
