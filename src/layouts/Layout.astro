---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  markdownUrl?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = 'Fluidise — The Agent-First Developer Experience Suite',
  description = 'Deterministic, standalone, and high-performance developer tools designed for AI coding agents and human maintainers.',
  markdownUrl,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://fluidise.acrazie.dev').href;
const canonicalImageSrc = new URL('/brand/banner.png', Astro.site ?? 'https://fluidise.acrazie.dev').href;
const absoluteMarkdownUrl = markdownUrl
  ? new URL(markdownUrl, Astro.site ?? 'https://fluidise.acrazie.dev').href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    {Astro.url.pathname === "/" && <link rel="preload" href="/fonts/BarlowCondensed-Bold-latin.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href="/fonts/InstrumentSans-Variable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    {/* Machine & Agent Discovery */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM & Agent Discovery Index" />
    {absoluteMarkdownUrl && (
      <link rel="alternate" type="text/markdown" href={absoluteMarkdownUrl} title="Raw Markdown specification" />
    )}

    {/* Security Meta Tags */}
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151515" />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={canonicalImageSrc} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={canonicalImageSrc} />

    {/* Structured Data (JSON-LD) */}
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div>
      <Navbar />
      <main id="main-content" class="page-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
