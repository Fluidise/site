---
import { CompanionLogo } from './CompanionLogo';
---

<footer class="border-t border-white/[0.08] bg-[#070609] py-12 sm:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 pb-10 border-b border-white/[0.06]">
      {/* Brand & Companion */}
      <div class="flex items-center gap-3">
        <CompanionLogo client:visible size={36} className="text-amber-400" />
        <div>
          <span class="font-bold tracking-wider text-base text-white font-mono">FLUIDISE</span>
          <p class="text-xs text-zinc-400 mt-0.5">Agent-first developer experience suite.</p>
        </div>
      </div>

      {/* Links */}
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 text-xs font-mono text-zinc-400">
        <div class="flex flex-col gap-2">
          <span class="text-zinc-200 font-semibold uppercase tracking-wider text-[11px]">Suite</span>
          <a href="/tools/clint" class="hover:text-amber-300 transition-colors">fluidise-clint</a>
          <a href="/tools/relay" class="hover:text-amber-300 transition-colors">fluidise-relay</a>
          <a href="https://github.com/Fluidise/homebrew-tap" target="_blank" rel="noreferrer" class="hover:text-amber-300 transition-colors">homebrew-tap</a>
        </div>

        <div class="flex flex-col gap-2">
          <span class="text-zinc-200 font-semibold uppercase tracking-wider text-[11px]">Foundation</span>
          <a href="https://github.com/Fluidise/core" target="_blank" rel="noreferrer" class="hover:text-amber-300 transition-colors">core repo</a>
          <a href="https://github.com/Fluidise/core/blob/main/docs/product-contract.md" target="_blank" rel="noreferrer" class="hover:text-amber-300 transition-colors">product contract</a>
          <a href="https://github.com/Fluidise/core/blob/main/docs/brand.md" target="_blank" rel="noreferrer" class="hover:text-amber-300 transition-colors">brand guide</a>
        </div>

        <div class="flex flex-col gap-2">
          <span class="text-zinc-200 font-semibold uppercase tracking-wider text-[11px]">Organization</span>
          <a href="https://github.com/Fluidise" target="_blank" rel="noreferrer" class="hover:text-amber-300 transition-colors">GitHub Org</a>
          <a href="https://github.com/Fluidise/site" target="_blank" rel="noreferrer" class="hover:text-amber-300 transition-colors">Site Repo</a>
          <span class="text-zinc-500">MIT License</span>
        </div>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500">
      <p>© 2026 Acrazie & Fluidise. Released under the MIT License.</p>
      <p>Designed with strictly deterministic standards.</p>
    </div>
  </div>
</footer>
