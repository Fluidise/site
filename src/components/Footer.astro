---
const isHome = Astro.url.pathname === '/';
---

<footer class:list={['site-footer', { 'site-footer-home': isHome }]}>
  <div class:list={['shell', { 'background-frame': !isHome }]}>
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" aria-label="Fluidise home"><img src="/brand/logo-white.svg" width="32" height="32" alt="" /></a>
        <div><strong>Fluidise</strong><p>Agent-first developer experience suite.</p></div>
      </div>
      <div class="footer-links">
        <div><strong>Tools</strong><a href="/tools/clint/">fluidise-clint</a><a href="/tools/relay/">fluidise-relay</a><a href="https://github.com/Fluidise/homebrew-tap" target="_blank" rel="noreferrer noopener">homebrew-tap</a></div>
        <div><strong>Project</strong><a href="https://github.com/Fluidise/core" target="_blank" rel="noreferrer noopener">Core repository</a><a href="https://github.com/Fluidise/core/tree/main/docs" target="_blank" rel="noreferrer noopener">Core specifications</a><a href="https://github.com/Fluidise/core/blob/main/docs/product-contract.md" target="_blank" rel="noreferrer noopener">Product contract</a><a href="https://github.com/Fluidise/core/blob/main/docs/brand.md" target="_blank" rel="noreferrer noopener">Brand guide</a><a href="https://github.com/Fluidise" target="_blank" rel="noreferrer noopener">GitHub organization</a><a href="https://github.com/Fluidise/site" target="_blank" rel="noreferrer noopener">Site repository</a><span>MIT License</span></div>
      </div>
    </div>
    <div class="footer-legal"><p>© 2026 Acrazie &amp; Fluidise. Released under the MIT License.</p><p>Designed with strictly deterministic standards.</p></div>
  </div>
</footer>
