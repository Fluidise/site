---
import banner from '../../assets/plates/alpine-banner.png';
import compressedBanner from '../../assets/plates/alpine-banner.webp';
---
<section class="alpine-hero" aria-label="Fluidise">
  <picture>
    <source srcset={compressedBanner.src} type="image/webp" />
    <img class="alpine-hero__image" src={banner.src} width={banner.width} height={banner.height} alt="" fetchpriority="high" loading="eager" decoding="async" />
  </picture>
  <h1 class="alpine-hero__title">FLUIDISE<span class="sr-only"> — Agent-first developer experience suite</span></h1>
</section>
