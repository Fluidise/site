---
import { getImage } from 'astro:assets';
import plate from '../../assets/plates/suspended-archipelago.png';
import background from '../../assets/plates/suspended-archipelago-background.png';
import contours from '../../assets/plates/suspended-archipelago-contours.json';

const [artwork, sky] = await Promise.all([
  getImage({ src: plate, format: 'webp', quality: 90 }),
  getImage({ src: background, format: 'webp', quality: 90 }),
]);
const id = `archipelago-${crypto.randomUUID()}`;
---

<archipelago-hero data-scroll style={`--title-paint: url("${sky.src}")`} class="archipelago-hero" role="region" aria-label="Fluidise">
  <div class="archipelago-hero__viewport">
    <img class="archipelago-hero__fallback" src={artwork.src} width={plate.width} height={plate.height} alt="" fetchpriority="high" loading="eager" decoding="async" />
    <div class="archipelago-hero__scene" aria-hidden="true">
      <img class="archipelago-hero__background" src={sky.src} width={background.width} height={background.height} alt="" loading="eager" decoding="async" />
      <div class="archipelago-hero__island">
        <svg class="archipelago-hero__layer" viewBox={`0 0 ${plate.width} ${plate.height}`} preserveAspectRatio="xMidYMid slice" focusable="false">
          <defs><clipPath id={`${id}-island`} clipPathUnits="userSpaceOnUse"><path data-island-mask d={contours.island} /></clipPath></defs>
          <image href={artwork.src} width={plate.width} height={plate.height} clip-path={`url(#${id}-island)`} />
        </svg>
      </div>
      <svg class="archipelago-hero__layer archipelago-hero__foreground" viewBox={`0 0 ${plate.width} ${plate.height}`} preserveAspectRatio="xMidYMid slice" focusable="false">
        <defs><clipPath id={`${id}-foreground`} clipPathUnits="userSpaceOnUse"><path data-foreground-mask d={contours.foreground} /></clipPath></defs>
        <image href={artwork.src} width={plate.width} height={plate.height} clip-path={`url(#${id}-foreground)`} />
      </svg>
      <canvas class="archipelago-hero__clouds" aria-hidden="true"></canvas>
    </div>
    <h1 class="archipelago-hero__title"><span class="archipelago-hero__wordmark">FLUIDISE</span><span class="sr-only"> — Agent-first developer experience suite</span></h1>
    <div class="archipelago-hero__title archipelago-hero__title-front" aria-hidden="true"><span class="archipelago-hero__wordmark">FLUIDISE</span></div>
  </div>
</archipelago-hero>
<noscript>
  <style is:inline>
    .archipelago-hero[data-scroll] { height: 100vh; height: 100dvh; }
    .archipelago-hero__viewport { position: relative; }
  </style>
</noscript>

<script>
  import { ArchipelagoClouds, type ArchipelagoPose } from './ArchipelagoClouds';

  class ArchipelagoHero extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      this.dispose?.();
      const original = this.querySelector<HTMLImageElement>('.archipelago-hero__fallback');
      const background = this.querySelector<HTMLImageElement>('.archipelago-hero__background');
      const viewport = this.querySelector<HTMLElement>('.archipelago-hero__viewport');
      const canvas = this.querySelector<HTMLCanvasElement>('.archipelago-hero__clouds');
      const islandPath = this.querySelector('[data-island-mask]')?.getAttribute('d');
      const foregroundPath = this.querySelector('[data-foreground-mask]')?.getAttribute('d');
      if (!original || !background || !viewport || !canvas || !islandPath || !foregroundPath) return;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      // Reserve scroll geometry before decoding, even on deep links and history restoration.
      this.toggleAttribute('data-scroll', !reduced.matches);
      const events = new AbortController();
      let renderer: ArchipelagoClouds | null = null;
      let decoded = false;
      let failed = false;
      let lost = false;
      let disposed = false;
      let visible = true;
      let needsMeasure = true;
      let frame: number | null = null;
      let bounds = { top: 0, height: 0 };
      let width = 0;
      let height = 0;
      const properties = ['--island-x', '--island-y', '--island-scale', '--foreground-x', '--foreground-y', '--foreground-scale', '--title-y', '--title-scale', '--title-front', '--title-opacity'];
      const present = () => !disposed && visible && !document.hidden;
      const cancel = () => {
        if (frame !== null) cancelAnimationFrame(frame);
        frame = null;
      };
      const reset = () => {
        this.removeAttribute('data-ready');
        for (const property of properties) this.style.removeProperty(property);
      };
      const fail = () => {
        if (disposed) return;
        failed = true;
        renderer?.dispose();
        renderer = null;
        cancel();
        reset();
        // Keep reserved scroll geometry on GPU failure; never move the reader abruptly.
      };
      const measure = () => {
        bounds = this.getBoundingClientRect();
        const size = viewport.getBoundingClientRect();
        if (width !== size.width || height !== size.height) {
          width = size.width;
          height = size.height;
          if (width > 0 && height > 0) renderer?.resize(width, height);
        }
        needsMeasure = false;
      };
      const render = () => {
        frame = null;
        if (!present()) return;
        try {
          if (needsMeasure) measure();
          if (reduced.matches || width <= 0 || height <= 0) return;
          if (decoded && !failed && !lost && !renderer) {
            renderer = new ArchipelagoClouds(canvas, background, { island: islandPath, foreground: foregroundPath });
            renderer.resize(width, height);
          }
          if (!renderer || failed || lost) return;
          const progress = Math.min(1, Math.max(0, -bounds.top / Math.max(1, bounds.height - height)));
          const smooth = (start: number, end: number) => {
            const t = Math.min(1, Math.max(0, (progress - start) / (end - start)));
            return t * t * (3 - 2 * t);
          };
          const approach = smooth(0, 1);
          const departure = smooth(.05, .85);
          const narrow = width <= 600;
          const pose: ArchipelagoPose = {
            islandX: -width * approach * (narrow ? .08 : .14),
            islandY: -height * approach * .035,
            islandScale: 1 + approach * (narrow ? .35 : .6),
            // Move the foreground's source edges outward as it leaves the view.
            foregroundX: -width * departure * .3,
            foregroundY: height * departure * .36,
            foregroundScale: 1 + departure * .85,
          };
          for (const [key, value] of Object.entries({
            '--island-x': `${pose.islandX}px`, '--island-y': `${pose.islandY}px`, '--island-scale': `${pose.islandScale}`,
            '--foreground-x': `${pose.foregroundX}px`, '--foreground-y': `${pose.foregroundY}px`, '--foreground-scale': `${pose.foregroundScale}`,
            '--title-y': `${height * smooth(.02, .6) * .25}px`, '--title-scale': `${1 + smooth(.02, .5) * .08}`, '--title-front': `${1 - smooth(0, .16)}`, '--title-opacity': `${1 - smooth(.18, .68)}`,
          })) this.style.setProperty(key, value);
          renderer.draw(progress, pose);
          this.setAttribute('data-ready', '');
          // Fade a decorative front face into the same semantic title behind the rock.
          // This avoids a sudden z-index cut where the initial lettering overlaps the island.
          // No clock and no follow-up frame: stopping scroll freezes every layer.
        } catch { fail(); }
      };
      const schedule = () => {
        needsMeasure = true;
        if (present() && frame === null) frame = requestAnimationFrame(render);
      };
      const observer = 'IntersectionObserver' in window ? new IntersectionObserver(([entry]) => {
        if (disposed) return;
        visible = entry.isIntersecting;
        if (!visible) cancel();
        else schedule();
      }) : null;
      const resizeObserver = 'ResizeObserver' in window ? new ResizeObserver(schedule) : null;
      observer?.observe(this);
      resizeObserver?.observe(this);
      resizeObserver?.observe(viewport);
      const signal = events.signal;
      window.addEventListener('scroll', schedule, { passive: true, signal });
      window.addEventListener('resize', schedule, { signal });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancel();
        else schedule();
      }, { signal });
      reduced.addEventListener('change', () => {
        if (disposed) return;
        cancel();
        this.toggleAttribute('data-scroll', !reduced.matches);
        if (reduced.matches) reset();
        schedule();
      }, { signal });
      this.addEventListener('error', fail, { capture: true, signal });
      canvas.addEventListener('webglcontextlost', (event) => {
        if (disposed) return;
        event.preventDefault();
        lost = true;
        renderer?.dispose();
        renderer = null;
        cancel();
        reset();
      }, { signal });
      canvas.addEventListener('webglcontextrestored', () => {
        if (disposed || !lost) return;
        lost = false;
        schedule();
      }, { signal });

      this.dispose = () => {
        disposed = true;
        cancel();
        events.abort();
        observer?.disconnect();
        resizeObserver?.disconnect();
        renderer?.dispose();
        renderer = null;
        this.removeAttribute('data-scroll');
        reset();
      };
      Promise.all([original.decode(), background.decode()]).then(() => {
        if (disposed || failed) return;
        decoded = true;
        schedule();
      }).catch(fail);
    }

    disconnectedCallback() {
      this.dispose?.();
      this.dispose = undefined;
    }
  }
  if (!customElements.get('archipelago-hero')) customElements.define('archipelago-hero', ArchipelagoHero);
</script>
