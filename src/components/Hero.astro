---
import { IconArrowRight, IconCopy, IconCheck, IconSparkles } from '@tabler/icons-react';
import { InteractiveTerminal } from './InteractiveTerminal';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  {/* Background ambient lighting */}
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-amber-500/10 blur-[140px] pointer-events-none rounded-full" />
  <div class="absolute top-1/3 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[300px] bg-purple-500/10 blur-[130px] pointer-events-none rounded-full" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      {/* Tag badge */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.1] text-amber-300 text-xs font-mono mb-6 backdrop-blur-md animate-fade-in-up">
        <IconSparkles size={14} className="text-amber-400" />
        <span>Agent-First Developer Experience Suite</span>
      </div>

      {/* Main Title - Rendered directly in SSR HTML (no opacity: 0) */}
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-[1.1] animate-fade-in-up [animation-delay:100ms]">
        Developer tools designed for{' '}
        <span class="bg-gradient-to-r from-amber-200 via-amber-400 to-amber-500 bg-clip-text text-transparent">
          AI agents
        </span>{' '}
        and developers.
      </h1>

      {/* Subtitle */}
      <p class="text-base sm:text-lg text-zinc-300 leading-relaxed max-w-2xl mx-auto mb-8 animate-fade-in-up [animation-delay:200ms]">
        Autonomous tools with strict operational determinism, machine-readable JSON outputs, and zero side-effects. Designed as independent Unix-style building blocks.
      </p>

      {/* Action CTAs */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 animate-fade-in-up [animation-delay:300ms]">
        <a
          href="#tools"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-black font-semibold text-sm transition-all shadow-[0_0_24px_rgba(245,158,11,0.25)] hover:shadow-[0_0_32px_rgba(245,158,11,0.4)] focus-visible:ring-2 focus-visible:ring-amber-400"
        >
          <span>Explore Tools</span>
          <IconArrowRight size={16} />
        </a>

        {/* Copy Tap Command Button with Accessible Feedback */}
        <button
          id="hero-copy-brew-btn"
          type="button"
          aria-label="Copy Homebrew tap installation command"
          class="w-full sm:w-auto inline-flex items-center justify-between gap-3 px-4 py-3 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.1] text-zinc-200 font-mono text-xs sm:text-sm transition-all focus-visible:ring-2 focus-visible:ring-amber-400"
        >
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-amber-400 shrink-0">$</span>
            <span class="truncate">brew tap Fluidise/homebrew-tap</span>
          </div>
          <span class="text-zinc-400 hover:text-white shrink-0 p-1">
            <span id="hero-copy-icon-default"><IconCopy size={16} /></span>
            <span id="hero-copy-icon-success" class="hidden text-emerald-400"><IconCheck size={16} /></span>
          </span>
        </button>
      </div>
      <div id="hero-copy-feedback" class="sr-only" aria-live="polite"></div>
    </div>

    {/* Live Interactive Playground Terminal - Island loaded on idle */}
    <div class="relative animate-fade-in-up [animation-delay:400ms]">
      <InteractiveTerminal client:idle />
    </div>
  </div>
</section>

<script is:inline>
  const copyBtn = document.getElementById('hero-copy-brew-btn');
  const iconDefault = document.getElementById('hero-copy-icon-default');
  const iconSuccess = document.getElementById('hero-copy-icon-success');
  const feedback = document.getElementById('hero-copy-feedback');

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('brew tap Fluidise/homebrew-tap')
        .then(() => {
          if (iconDefault && iconSuccess) {
            iconDefault.classList.add('hidden');
            iconSuccess.classList.remove('hidden');
          }
          if (feedback) feedback.textContent = 'Command copied to clipboard';
          setTimeout(() => {
            if (iconDefault && iconSuccess) {
              iconDefault.classList.remove('hidden');
              iconSuccess.classList.add('hidden');
            }
            if (feedback) feedback.textContent = '';
          }, 2000);
        })
        .catch((err) => console.error('Failed to copy to clipboard', err));
    });
  }
</script>
