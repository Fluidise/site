---
import { IconBook2, IconBrandGithub, IconCirclesRelation } from '@tabler/icons-react';
---
<nav class="floating-dock" aria-label="Main navigation">
  <a class="dock-link" href="/#tools" data-section="tools">
    <img src="/brand/logo.svg" alt="" width="25" height="25" />
    <span>Tools</span>
  </a>
  <a class="dock-link" href="/#philosophy" data-section="philosophy">
    <IconCirclesRelation size={23} aria-hidden="true" />
    <span>Philosophy</span>
  </a>
  <a class="dock-link" aria-label="Specifications (opens in new tab)" href="https://github.com/Fluidise/core/tree/main/docs" target="_blank" rel="noreferrer noopener">
    <IconBook2 size={23} aria-hidden="true" />
    <span class="dock-label-full" aria-hidden="true">Specifications</span><span class="dock-label-compact" aria-hidden="true">Docs</span>
  </a>
  <a class="dock-link" href="https://github.com/Fluidise" target="_blank" rel="noreferrer noopener">
    <IconBrandGithub size={23} aria-hidden="true" />
    <span>GitHub<span class="sr-only"> (opens in new tab)</span></span>
  </a>
</nav>
<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.dock-link[data-section]');
  const sections = [...links].map((link) => document.getElementById(link.dataset.section ?? '')).filter((section): section is HTMLElement => Boolean(section));
  function markCurrent(id: string) {
    for (const link of links) {
      if (link.dataset.section === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }
  if (sections.length) {
    markCurrent(location.hash === '#philosophy' ? 'philosophy' : 'tools');
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting) markCurrent(entry.target.id);
    }, { rootMargin: '-10% 0px -35% 0px' });
    sections.forEach((section) => observer.observe(section));
    links.forEach((link) => link.addEventListener('click', () => markCurrent(link.dataset.section ?? 'tools')));
  }
</script>
