---
import { IconDownload, IconBrandGithub, IconCirclesRelation } from '@tabler/icons-react';
---
<fluidise-navbar>
  <nav class="floating-dock" aria-label="Main navigation">
    <a class="dock-link" href="/#tools" data-section="tools"><img src="/brand/logo-white.svg" alt="" width="25" height="25" /><span>Explore</span></a>
    <a class="dock-link" href="/#install" data-section="install"><IconDownload size={23} aria-hidden="true" /><span>Install</span></a>
    <a class="dock-link" href="/#philosophy" data-section="philosophy"><IconCirclesRelation size={23} aria-hidden="true" /><span>Principles</span></a>
    <a class="dock-link" href="https://github.com/Fluidise" target="_blank" rel="noreferrer noopener"><IconBrandGithub size={23} aria-hidden="true" /><span>GitHub<span class="sr-only"> (opens in new tab)</span></span></a>
  </nav>
</fluidise-navbar>
<script>
  class FluidiseNavbar extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      this.dispose?.();
      const nav = this.querySelector<HTMLElement>('nav');
      if (!nav) return;
      const hero = document.querySelector<HTMLElement>('archipelago-hero');
      const links = [...this.querySelectorAll<HTMLAnchorElement>('.dock-link[data-section]')];
      const sections = links.map((link) => document.getElementById(link.dataset.section ?? '')).filter((section): section is HTMLElement => Boolean(section));
      const events = new AbortController();
      let disposed = false;
      let frame: number | null = null;
      const markCurrent = (id: string) => {
        for (const link of links) {
          if (link.dataset.section === id) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      };
      const markHash = () => {
        if (!hero) return markCurrent('');
        const hash = location.hash;
        markCurrent(hash === '#philosophy' ? 'philosophy' : /^#install(?:-|$)/.test(hash) ? 'install' : !hash || hash === '#tools' ? 'tools' : '');
      };
      const cancel = () => {
        if (frame !== null) cancelAnimationFrame(frame);
        frame = null;
      };
      const sync = () => {
        frame = null;
        if (disposed || document.hidden) return;
        // Preserve the exact hero boundary, including reverse scroll and deep entry.
        nav.hidden = Boolean(hero?.isConnected && hero.getBoundingClientRect().bottom > window.innerHeight - 1);
        if (!hero || nav.hidden) return;
        const readingLine = Math.max(28, window.innerHeight * 0.28);
        let current = '';
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= readingLine) current = section.id;
        }
        markCurrent(current);
      };
      const schedule = () => {
        if (!disposed && !document.hidden && frame === null) frame = requestAnimationFrame(sync);
      };
      const observer = hero && sections.length && 'IntersectionObserver' in window ? new IntersectionObserver(() => {
        if (!disposed) schedule();
      }, { rootMargin: '-10% 0px -35% 0px' }) : null;
      sections.forEach((section) => observer?.observe(section));
      markHash();
      const signal = events.signal;
      for (const link of links) link.addEventListener('click', () => {
        if (hero && !disposed) markCurrent(link.dataset.section ?? '');
      }, { signal });
      const resizeObserver = hero && 'ResizeObserver' in window ? new ResizeObserver(schedule) : null;
      if (hero) {
        resizeObserver?.observe(hero);
        sections.forEach((section) => resizeObserver?.observe(section));
        window.addEventListener('scroll', schedule, { passive: true, signal });
        window.addEventListener('resize', schedule, { signal });
        for (const event of ['hashchange', 'popstate']) window.addEventListener(event, () => {
          markHash();
          schedule();
        }, { signal });
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) cancel();
          else schedule();
        }, { signal });
      }
      sync();
      this.dispose = () => {
        disposed = true;
        cancel();
        events.abort();
        observer?.disconnect();
        resizeObserver?.disconnect();
        nav.hidden = false;
        markCurrent('');
      };
    }

    disconnectedCallback() {
      this.dispose?.();
      this.dispose = undefined;
    }
  }
  if (!customElements.get('fluidise-navbar')) customElements.define('fluidise-navbar', FluidiseNavbar);
</script>
