{
  "name": "fluidise-site",
  "version": "0.1.0",
  "description": "Official website and tool hub for the Fluidise developer experience suite.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit",
    "check:endpoints": "bun run src/tests/verify-endpoints.ts",
    "lint": "oxlint",
    "lint:spelling": "typos",
    "lint:links": "lychee --offline --config lychee.toml dist/**/*.html dist/llms.txt dist/llms-full.txt dist/tools.json dist/manifesto.md",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci": "dagger call check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@tabler/icons-react": "^3.49.0",
    "astro": "^7.4.2",
    "clsx": "^2.1.1",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
